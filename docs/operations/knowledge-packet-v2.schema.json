{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getinksights.co.uk/schemas/knowledge-packet-v2.json",
  "title": "INKSIGHTS Knowledge Packet v2",
  "type": "object",
  "required": [
    "source",
    "title",
    "business_key",
    "asset_type",
    "summary",
    "classification_confidence",
    "evidence_classification",
    "recommended_destination",
    "review_status"
  ],
  "properties": {
    "source": {"type": "string"},
    "source_ref": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "original_name": {"type": ["string", "null"]},
    "business_key": {
      "type": "string",
      "enum": ["shared", "inksights", "amazon", "tattoos_by_daniel_hughes", "personal"]
    },
    "asset_type": {"type": "string"},
    "category": {"type": ["string", "null"]},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "summary": {"type": "string"},
    "content_hash": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["VERIFIED", "OBSERVED", "CALCULATED", "MODELLED", "HYPOTHESIS"]
      },
      "uniqueItems": true
    },
    "factual_claims": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array", "items": {"type": "string"}},
    "calculations": {"type": "array", "items": {"type": "string"}},
    "models": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "reusable_ip": {"type": "array", "items": {"type": "string"}},
    "product_opportunities": {"type": "array", "items": {"type": "string"}},
    "commercial_implications": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "related_asset_keys": {"type": "array", "items": {"type": "string"}},
    "inksights_relevance": {"type": ["string", "null"]},
    "recommended_destination": {"type": "string"},
    "approval_required": {"type": "boolean"},
    "review_status": {
      "type": "string",
      "enum": ["not_reviewed", "pending", "verified", "rejected"]
    }
  },
  "additionalProperties": false
}
